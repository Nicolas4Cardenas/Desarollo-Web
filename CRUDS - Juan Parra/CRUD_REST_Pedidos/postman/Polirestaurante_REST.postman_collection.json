              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"id_pedido\", pm.response.json().pedido.id_pedido);\npm.test(\"Estado PENDIENTE\", function () { pm.expect(pm.response.json().pedido.estado).to.eql(\"PENDIENTE\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{id_mesero}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_mesa\": {{id_mesa}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Crea el pedido en estado PENDIENTE, registra fecha/hora y marca la mesa como ocupada. Guarda id_pedido en las variables."
